{
	"info": {
		"_postman_id": "streamflow-analysis-001",
		"name": "StreamFlow - Análise de Arquitetura",
		"description": "Coleção para diagnóstico de latência, resiliência e acoplamento no projeto StreamFlow.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "01. Autenticação (Setup Inicial)",
			"item": [
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.globals.set(\"SF_TOKEN\", jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@streamflow.com\",\n    \"password\": \"admin123\"\n}"
						},
						"url": { "raw": "http://localhost:8080/auth/login" }
					}
				}
			]
		},
		{
			"name": "02. Testes de Latência (Cadeia Síncrona)",
			"item": [
				{
					"name": "Iniciar Reprodução (Play)",
					"description": "Este endpoint toca 3 serviços internos de forma síncrona: Catalog, Recommendation e Notification.",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{SF_TOKEN}}" },
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"movieId\": 1\n}"
						},
						"url": { "raw": "http://localhost:8080/api/streaming/play" }
					}
				}
			]
		},
		{
			"name": "03. Testes de Acoplamento (Shared Database)",
			"item": [
				{
					"name": "Gerar Relatório de Analytics",
					"description": "Teste: Desligue o billing-service e veja se este endpoint continua funcionando. Se funcionar, prova o acoplamento pelo banco.",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{SF_TOKEN}}" }
						],
						"url": { "raw": "http://localhost:8080/api/analytics/report" }
					}
				}
			]
		},
		{
			"name": "04. Observabilidade e Saúde",
			"item": [
				{
					"name": "Health Check Geral",
					"request": {
						"method": "GET",
						"header": [],
						"url": { "raw": "http://localhost:8080/health" }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "SF_TOKEN", "value": "" }
	]
}